# ---- copy to .env for local dev; Render pe dashboard me daalo (bina quotes) ----
API_ID=
API_HASH=
BOT_TOKEN=
ADMIN_USERNAME=agrikrishna
MONGO_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/telegram_automation?retryWrites=true&w=majority
TARGET_GROUP=agriquizworld

# both = harvester + injector (active/standby setup me DONO Render pe both)
INSTANCE_ROLE=both
# readable naam; code khud per-process suffix jodta hai (render-A-3f9c1a)
INSTANCE_ID=render-A
ENABLE_ADMIN_BOT=true

# engines port khulne ke itne sec baad start (deploy overlap protection) — 30 rakho
STARTUP_DELAY=30
# true = DRY RUN (koi user add nahi hoga). Production = false
TEST_MODE=false
# injector sirf in IST ghanto me chalega. 0-24 = hamesha
ACTIVE_HOURS_IST=8-23
LOG_LEVEL=INFO
# optional: 15-min spin-down rokne ke liye apna hi URL
# SELF_PING_URL=https://telegram-w6do.onrender.com/

# ---- harvester bandwidth controls (defaults theek hain) ----
# HARVEST_INTERVAL_SECONDS=10800   # round har 3h (DB me checkpoint, deploy pe repeat nahi)
# QUEUE_TARGET_PENDING=1500        # itne pending ho to harvest skip
# HARVEST_MAX_NEW_PER_RUN=2000     # checkpoint ke baad max naye msgs per channel per run
# HARVEST_INITIAL_LIMIT=1000       # naye channel pe pehli baar
